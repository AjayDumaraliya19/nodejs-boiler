{
  "name": "nodejs-boiler",
  "version": "1.0.4",
  "description": "A fast and modern Node.js project boilerplate generator CLI that instantly sets up a ready-to-use Express app with folder structure, authentication, error handling, and reusable utilities.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "nodejs-boiler": "./src/index.js"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "dev": "nodemon ./src/index.js"
  },
  "author": {
    "name": "Ajay Dumaraliya",
    "url": "https://github.com/AjayDumaraliya19/nodejs-boiler"
  },
  "license": "MIT",
  "keywords": [
    "nodejs",
    "boilerplate",
    "starter",
    "template",
    "setup",
    "generator",
    "project",
    "scaffold",
    "initializer",
    "cli",
    "automation",
    "tool",
    "command-line",
    "npx",
    "create",
    "clean-architecture",
    "backend",
    "express",
    "typescript",
    "javascript",
    "mongoose",
    "mySQL",
    "PostgreSQL"
  ],
  "homepage": "https://github.com/AjayDumaraliya19/nodejs-boiler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AjayDumaraliya19/nodejs-boiler.git"
  },
  "bugs": {
    "url": "https://github.com/AjayDumaraliya19/nodejs-boiler/issues"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "fs-extra": "^11.3.2",
    "inquirer": "^12.10.0",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "src/",
    "template/"
  ]
}
