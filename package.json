    "microservices",
    "server",
    "backend",
    "fullstack",
    "mvc",
    "clean-architecture",
    "best-practices",
    "eslint",
    "prettier",
    "jest",
    "testing"
  ],
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "src/",
    "templates/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
