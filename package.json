{
  "name": "nodejs-boiler",
  "version": "1.0.1",
  "description": "🚀 A fast, modern, and production-ready Node.js project boilerplate generator CLI. Quickly scaffold a full-featured Express.js application with authentication, database setup, API structure, and best practices.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "nodejs-boiler": "./src/index.js"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AjayDumaraliya19/nodejs-boiler.git"
  },
  "homepage": "https://github.com/AjayDumaraliya19/nodejs-boiler#readme",
  "bugs": {
    "url": "https://github.com/AjayDumaraliya19/nodejs-boiler/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/AjayDumaraliya19"
  },
  "author": {
    "name": "Ajay Dumaraliya",
    "url": "https://github.com/AjayDumaraliya19"
  },
  "contributors": [
    {
      "name": "Ajay Dumaraliya",
      "url": "https://github.com/AjayDumaraliya19"
    }
  ],
  "license": "MIT",
  "keywords": [
    "nodejs",
    "boilerplate",
    "starter",
    "template",
    "scaffold",
    "generator",
    "project",
    "initializer",
    "cli",
    "express",
    "typescript",
    "javascript",
    "mongodb",
    "mongoose",
    "mysql",
    "postgresql",
